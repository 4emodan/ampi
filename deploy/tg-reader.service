[Unit]
Description=Telegram reader for Claude Assistant (reads for the assistant; writes only for ampi-tools)
After=network-online.target
Wants=network-online.target
# Only once you've logged in (tg-reader login); otherwise it would restart forever.
ConditionPathExists=/home/tgreader/tg-reader.session

[Service]
Type=simple
User=tgreader
Group=tgread
EnvironmentFile=/home/tgreader/env
ExecStart=/home/tgreader/app/.venv/bin/tg-reader serve
# /run/tg-reader/tg-reader.sock: only tgreader and the tgread group (the assistant) can reach it.
# /run/tg-writer/tg-write.sock: the daemon gives that directory to the tgwrite group (ampi-tools only) and
# also checks the caller is the ampitools user. The assistant can't reach it.
RuntimeDirectory=tg-reader tg-writer
RuntimeDirectoryMode=0750
SupplementaryGroups=tgwrite
UMask=0077
Restart=always
RestartSec=30

MemoryMax=300M
CPUQuota=50%
TasksMax=32
# The session file in /home/tgreader is the only thing it can write; other homes are hidden.
ProtectHome=tmpfs
BindPaths=/home/tgreader
ProtectSystem=strict
ReadWritePaths=/home/tgreader
PrivateTmp=true
NoNewPrivileges=true
InaccessiblePaths=-/opt -/srv -/var/www
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=
SystemCallFilter=@system-service
PrivateDevices=true
LockPersonality=true
MemoryDenyWriteExecute=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictNamespaces=true
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
