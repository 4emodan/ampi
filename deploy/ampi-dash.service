[Unit]
Description=Ampi dashboard on the web (docs/DASHBOARD.md)
Requires=ampi-dash.socket
After=ampi-dash.socket

[Service]
Type=simple
User=ampidash
Group=ampidash
# To reach ampi-tools' socket, which lets this user ask only for what a signed-in owner may.
SupplementaryGroups=ampitools
EnvironmentFile=/etc/ampi-dash/env
ExecStart=/usr/bin/python3 -I /usr/local/lib/ampi-dash/dash.py
Restart=on-failure
RestartSec=5
StandardError=journal

MemoryMax=96M
MemorySwapMax=0
TasksMax=24
CPUQuota=30%
LimitNOFILE=64
LimitCORE=0

# Everything it needs comes through Unix sockets.
PrivateNetwork=true
RestrictAddressFamilies=AF_UNIX

NoNewPrivileges=true
CapabilityBoundingSet=
AmbientCapabilities=
RestrictSUIDSGID=true
LockPersonality=true
RestrictRealtime=true
RestrictNamespaces=true
KeyringMode=private
RemoveIPC=true
UMask=0077
MemoryDenyWriteExecute=true
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
SystemCallFilter=~@aio
SystemCallErrorNumber=EPERM

ProtectSystem=strict
ProtectHome=yes
PrivateTmp=true
PrivateDevices=true
PrivateIPC=true
ProtectProc=invisible
ProcSubset=pid
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
InaccessiblePaths=-/opt -/srv -/var/www -/run/ampi-hub -/run/ampi-checkout.sock -/run/ampi-signin.sock
