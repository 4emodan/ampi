[Unit]
Description=Sandboxed web browser for Claude Assistant (one page per connection)
# No dependency on ampi-browser-net here (sockets start before basic.target, which would make a boot
# cycle); each instance requires it and checks the firewall itself before starting.

[Socket]
# Root owns the socket, so nothing the browser runs can re-bind it. Group ampibrowse = the assistant only;
# the browser's own user (ampibrowser) is deliberately not in it.
ListenStream=/run/ampi-browser.sock
SocketUser=root
SocketGroup=ampibrowse
SocketMode=0660
Accept=yes
# One page at a time (the box has no swap); the `browse` command queues callers with a lock.
MaxConnections=1
TriggerLimitIntervalSec=10s
TriggerLimitBurst=200

[Install]
WantedBy=sockets.target
