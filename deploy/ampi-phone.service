[Unit]
Description=Ampi phone gateway (keeps the paired phone connected; docs/COMPANION.md)
Requires=ampi-phone.socket
After=ampi-phone.socket

[Service]
Type=simple
User=ampiphone
Group=ampiphone
EnvironmentFile=/etc/ampi-phone/gateway.env
Sockets=ampi-phone.socket ampi-phone-vault.socket
ExecStart=/usr/bin/python3 -I /usr/local/lib/ampi-phone/run.py
Restart=always
RestartSec=5
StandardError=journal

MemoryMax=96M
MemorySwapMax=0
TasksMax=8
CPUQuota=30%
LimitNOFILE=512
LimitCORE=0

# The listening sockets come from systemd, so the gateway needs no network of its own. The inherited listener still
# belongs to the host's network: without connect() and shutdown() (also not through io_uring, part of @aio) it can't be
# turned into an outgoing connection: the second SystemCallFilter=~ line below.
PrivateNetwork=true
RestrictAddressFamilies=AF_UNIX

NoNewPrivileges=true
CapabilityBoundingSet=
AmbientCapabilities=
RestrictSUIDSGID=true
LockPersonality=true
RestrictRealtime=true
RestrictNamespaces=true
KeyringMode=private
RemoveIPC=true
UMask=0077
MemoryDenyWriteExecute=true
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
SystemCallFilter=~connect shutdown @aio
SystemCallErrorNumber=EPERM

ProtectSystem=strict
ProtectHome=yes
PrivateTmp=true
PrivateDevices=true
PrivateIPC=true
ProtectProc=invisible
ProcSubset=pid
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
InaccessiblePaths=-/opt -/srv -/var/www

[Install]
WantedBy=multi-user.target