# Todoist: Settings -> Integrations -> Developer -> API token
TODOIST_TOKEN=
# Gmail: OAuth client (type "Desktop app") from Google Cloud Console, see docs/SETUP.md section 8
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
# YouTube Data API key (public data), see docs/SETUP.md section 8b. The account login
# (`ampi-tools youtube-login`) uses the Gmail OAuth client above.
YOUTUBE_API_KEY=
# Threads / Instagram app ids and secrets (Meta developer app), see docs/SETUP.md section 8c
THREADS_APP_ID=
THREADS_APP_SECRET=
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
# META_REDIRECT_URI=https://localhost:8765/
# Google Maps (Maps Experience agent tools API key), see docs/SETUP.md section 8b-2
MAPS_API_KEY=
# MAPS_LANGUAGE=en
# MAPS_REGION=FI
# MAPS_NEAR=60.1699,24.9384
# MAPS_TIMEZONE=Europe/Helsinki
# Wolt (unofficial; docs/SETUP.md 8b-3). Account: ampi-tools wolt-login
# WOLT_NEAR=60.1699,24.9384
# WOLT_LANGUAGE=en
