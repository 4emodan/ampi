{
  "manifest_version": 3,
  "name": "Ampi session",
  "version": "1.0",
  "description": "Gives your own assistant the session of the one site you are on, encrypted, when you tap it.",
  "permissions": ["activeTab", "cookies", "clipboardWrite"],
  "optional_host_permissions": ["https://*/*"],
  "action": {
    "default_title": "Ampi session",
    "default_popup": "popup.html",
    "default_icon": "icon.svg"
  },
  "icons": { "96": "icon.svg" },
  "content_security_policy": {
    "extension_pages": "default-src 'none'; script-src 'self'; style-src 'self'; img-src 'self'"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "@ID@",
      "strict_min_version": "142.0",
      "data_collection_permissions": { "required": ["authenticationInfo"] }
    },
    "gecko_android": { "strict_min_version": "142.0" }
  }
}
